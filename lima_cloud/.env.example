# Copiar a .env y completar antes de correr.

# --- Google Earth Engine ---
GEE_PROJECT=tu-proyecto-de-google-cloud
GEE_SERVICE_ACCOUNT_KEY=/ruta/a/tu-clave-de-cuenta-de-servicio.json

# --- Extension real de la cuenca (reemplazar el placeholder de config.py) ---
BASIN_LAT_MIN=-9.85
BASIN_LAT_MAX=-9.70
BASIN_LON_MIN=-77.50
BASIN_LON_MAX=-77.35
GRID_ROWS=6
GRID_COLS=6
NODE_QUADRANT_ID=3_2

# --- Cadencia ---
ACQUIRE_INTERVAL_HOURS=120

# --- Servidor ---
PORT=8080
CACHE_DIR=./cache
